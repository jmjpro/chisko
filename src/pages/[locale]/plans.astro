---
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../convex/_generated/api";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/footer";
import LeaveDetailsIsland from "../../islands/LeaveDetailsIsland";
import { getConvexUrl } from "../../lib/getConvexUrl";
import { commonByLocale } from "../../lib/commonLocale";
import type { Locale } from "../../lib/locale";

export function getStaticPaths() {
  return [
    { params: { locale: "en" } },
    { params: { locale: "ar" } },
    { params: { locale: "ru" } },
  ];
}

const { locale } = Astro.params;

const common = commonByLocale[locale as Locale];
const [suppliers, plans] = await Promise.all([
  import(`../../../public/locales/${locale}/suppliers.json`).then((m) => m.default as Record<string, string>),
  import(`../../../public/locales/${locale}/plans.json`).then((m) => m.default as Record<string, string>),
]);

const langSwitchUrls: Record<string, string> = {
  he: "/plans",
  en: "/en/plans",
  ar: "/ar/plans",
  ru: "/ru/plans",
};

const convexUrl = getConvexUrl(import.meta.env.VITE_CONVEX_URL);
const client = new ConvexHttpClient(convexUrl);
const rows = await client.query(api.plans.listActive);

function formatHour(h: number) {
  return `${String(h).padStart(2, "0")}:00`;
}

const viewRows = rows.map((row) => {
  const isFixed = row.planType === "fixed";
  const window =
    !isFixed &&
    row.discountWindowStartHour !== null &&
    row.discountWindowEndHour !== null
      ? `${formatHour(row.discountWindowStartHour)}–${formatHour(row.discountWindowEndHour)}`
      : common.all_day;
  const weekdayOnly = isFixed
    ? common.no
    : row.weekdayWindowOnly
      ? common.yes
      : common.all_week;
  return { ...row, window, weekdayOnly };
});
---

<BaseLayout
  locale={locale}
  title={`Chisko — ${common.plans_page_title}`}
  langSwitchUrls={langSwitchUrls}
>
  <main class="flex-1 px-6 py-8 overflow-x-auto">
      <h1 class="text-2xl font-bold mb-6">{common.plans_page_title}</h1>
      <div class="md:hidden flex flex-col gap-4">
        {
          viewRows.map((row) => (
            <div
              data-testid="plan-card"
              class="border rounded-lg p-4 flex flex-col gap-3"
            >
              <div class="flex items-start justify-between gap-3">
                <div>
                  <div class="font-semibold">{suppliers[row.supplierName] ?? row.supplierName}</div>
                  <div class="text-sm text-gray-600">{plans[row.planName] ?? row.planName}</div>
                </div>
                <span class="tnum shrink-0 rounded-full bg-green-100 text-green-800 font-semibold px-2.5 py-1 text-sm">
                  {row.discountPercent}%
                </span>
              </div>
              <dl class="text-sm grid grid-cols-2 gap-y-1">
                <dt class="text-gray-600">{common.table_type}</dt>
                <dd class="text-end">{common[`plan_type_${row.planType}`] ?? row.planType}</dd>
                <dt class="text-gray-600">{common.table_window}</dt>
                <dd class="text-end">{row.window}</dd>
                <dt class="text-gray-600">{common.table_weekday_only}</dt>
                <dd class="text-end">{row.weekdayOnly}</dd>
              </dl>
              <LeaveDetailsIsland
                client:only="react"
                locale={locale}
                convexUrl={convexUrl}
                supplierId={row.supplierId}
                planVersionId={row.pvId}
              />
            </div>
          ))
        }
      </div>
      <table class="hidden md:table w-full text-sm border-collapse">
        <thead>
          <tr class="border-b text-start">
            <th class="pb-2 pe-6 font-semibold text-start">{common.table_supplier}</th>
            <th class="pb-2 pe-6 font-semibold text-start">{common.table_plan}</th>
            <th class="pb-2 pe-6 font-semibold text-start">{common.table_type}</th>
            <th class="pb-2 pe-6 font-semibold text-start">{common.table_discount}</th>
            <th class="pb-2 pe-6 font-semibold text-start">{common.table_window}</th>
            <th class="pb-2 font-semibold text-start">{common.table_weekday_only}</th>
            <th class="pb-2 w-[158px]"></th>
          </tr>
        </thead>
        <tbody>
          {
            viewRows.map((row) => (
              <tr class="border-b last:border-0">
                <td class="py-3 pe-6">{suppliers[row.supplierName] ?? row.supplierName}</td>
                <td class="py-3 pe-6">{plans[row.planName] ?? row.planName}</td>
                <td class="py-3 pe-6">{common[`plan_type_${row.planType}`] ?? row.planType}</td>
                <td class="py-3 pe-6 tnum">{row.discountPercent}%</td>
                <td class="py-3 pe-6">{row.window}</td>
                <td class="py-3 pe-6">{row.weekdayOnly}</td>
                <td class="py-3 w-[158px]">
                  <div class="h-8">
                    <LeaveDetailsIsland
                      client:only="react"
                      locale={locale}
                      convexUrl={convexUrl}
                      supplierId={row.supplierId}
                      planVersionId={row.pvId}
                    />
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
  </main>
  <Footer />
</BaseLayout>
