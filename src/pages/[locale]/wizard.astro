---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WizardIsland from "../../islands/WizardIsland";
import { getConvexUrl } from "../../lib/getConvexUrl";
import { localeStaticPaths, type Locale } from "../../lib/locale";
import { wizardByLocale } from "../../lib/wizardLocale";

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale } = Astro.params;

const convexUrl = getConvexUrl(import.meta.env.VITE_CONVEX_URL);
---

<BaseLayout locale={locale} title={`Chisko — ${wizardByLocale[locale as Locale].page_title}`}>
  <WizardIsland client:only="react" locale={locale} convexUrl={convexUrl} />
</BaseLayout>
