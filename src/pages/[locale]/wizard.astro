---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WizardIsland from "../../islands/WizardIsland";
import { getConvexUrl } from "../../lib/getConvexUrl";

export function getStaticPaths() {
  return [
    { params: { locale: "en" } },
    { params: { locale: "ar" } },
    { params: { locale: "ru" } },
  ];
}

const { locale } = Astro.params;

const titles: Record<string, string> = {
  en: "Chisko — Wizard",
  ar: "Chisko — المعالج",
  ru: "Chisko — Мастер",
};

const convexUrl = getConvexUrl(import.meta.env.VITE_CONVEX_URL);
---

<BaseLayout locale={locale} title={titles[locale] ?? "Chisko"}>
  <WizardIsland client:only="react" locale={locale} convexUrl={convexUrl} />
</BaseLayout>
