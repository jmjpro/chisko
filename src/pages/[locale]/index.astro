---
import HomePage from "../../components/pages/HomePage.astro";
import { localeStaticPaths, buildLangSwitchUrls, type Locale } from "../../lib/locale";
import { homeByLocale } from "../../lib/homeLocale";

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale } = Astro.params;

const t = homeByLocale[locale as Locale];
const langSwitchUrls = buildLangSwitchUrls("/");
---

<HomePage
  locale={locale}
  title={`Chisko — ${t.hero_title}`}
  heroTitle={t.hero_title}
  heroSubtitle={t.hero_subtitle}
  ctaWizardLabel={t.cta_wizard}
  ctaPlansLabel={t.cta_plans}
  wizardHref={`/${locale}/wizard`}
  plansHref={`/${locale}/plans`}
  langSwitchUrls={langSwitchUrls}
/>
