---
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../convex/_generated/api";
import PlansPage from "../components/pages/PlansPage.astro";
import common from "../../public/locales/he/common.json";
import suppliers from "../../public/locales/he/suppliers.json";
import plans from "../../public/locales/he/plans.json";
import { getConvexUrl } from "../lib/getConvexUrl";
import { buildLangSwitchUrls } from "../lib/locale";
import { buildPlanRows } from "../lib/buildPlanRows";
import { sortPlanRowsByDiscountDesc } from "../lib/sortPlanRows";

const locale = "he";
const convexUrl = getConvexUrl(import.meta.env.VITE_CONVEX_URL);
const langSwitchUrls = buildLangSwitchUrls("/plans");

const client = new ConvexHttpClient(convexUrl);
const rows = await client.query(api.plans.listActive);

const processedRows = sortPlanRowsByDiscountDesc(
  buildPlanRows(
    rows,
    common as Record<string, string>,
    suppliers as Record<string, string>,
    plans as Record<string, string>,
  ),
);
---

<PlansPage
  locale={locale}
  convexUrl={convexUrl}
  common={common as Record<string, string>}
  rows={processedRows}
  langSwitchUrls={langSwitchUrls}
/>
