---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../footer";
import LeaveDetailsIsland from "../../islands/LeaveDetailsIsland";
import ClickThroughIsland from "../../islands/ClickThroughIsland";
import PlanFilterSortIsland from "../../islands/PlanFilterSortIsland";
import { buildFilterOptions } from "../../lib/buildFilterOptions";
import type { Id } from "../../../convex/_generated/dataModel";

interface PlanRow {
  pvId: Id<"planVersions">;
  supplierId: Id<"suppliers">;
  supportedHandoffTypes: string[];
  planType: string;
  supplierName: string;
  logoFileName: string;
  discountPercent: number;
  window: string;
  weekdayOnly: string;
  supplierLabel: string;
  planLabel: string;
  typeLabel: string;
}

interface Props {
  locale: string;
  convexUrl: string;
  common: Record<string, string>;
  rows: PlanRow[];
  langSwitchUrls: Record<string, string>;
}

const { locale, convexUrl, common, rows, langSwitchUrls } = Astro.props;
const filterOptions = buildFilterOptions(rows, common);
---

<BaseLayout
  locale={locale}
  title={`Chisko — ${common.plans_page_title}`}
  langSwitchUrls={langSwitchUrls}
>
  <main class="flex-1 px-6 py-8 overflow-x-auto">
    <h1 class="text-2xl font-bold mb-6">{common.plans_page_title}</h1>
    <PlanFilterSortIsland
      client:only="react"
      locale={locale}
      filterOptions={filterOptions}
    />
    <div role="table" class="plan-table text-sm">
      <div role="row" class="plan-header-row border-b text-start font-semibold">
        <div role="columnheader" class="cell-supplier pb-2 pe-6" aria-sort="none">
          <button type="button" data-sort-field="supplier" class="inline-flex items-center gap-1">
            {common.table_supplier}
            <span data-sort-indicator aria-hidden="true" class="text-gray-400">↕</span>
          </button>
        </div>
        <div role="columnheader" class="cell-plan pb-2 pe-6">{common.table_plan}</div>
        <div role="columnheader" class="cell-type pb-2 pe-6" aria-sort="none">
          <button type="button" data-sort-field="type" class="inline-flex items-center gap-1">
            {common.table_type}
            <span data-sort-indicator aria-hidden="true" class="text-gray-400">↕</span>
          </button>
        </div>
        <div role="columnheader" class="cell-discount pb-2 pe-6" aria-sort="descending">
          <button type="button" data-sort-field="discount" class="inline-flex items-center gap-1">
            {common.table_discount}
            <span data-sort-indicator aria-hidden="true" class="text-gray-700">↓</span>
          </button>
        </div>
        <div role="columnheader" class="cell-window pb-2 pe-6">{common.table_window}</div>
        <div role="columnheader" class="cell-weekday pb-2">{common.table_weekday_only}</div>
        <div role="columnheader" class="cell-actions pb-2"></div>
      </div>
      <div id="plan-rows" class="flex flex-col gap-4 md:gap-0">
        {
          rows.map((row) => (
            <div
              role="row"
              data-testid="plan-row"
              data-row-id={row.pvId}
              data-plan-type={row.planType}
              data-supplier={row.supplierName}
              data-supplier-label={row.supplierLabel}
              data-discount={row.discountPercent}
              class="plan-row border rounded-lg p-4 md:rounded-none md:border-0 md:border-b md:p-0 last:md:border-0 transition-colors duration-150 hover:bg-muted/50"
            >
              <div role="cell" class="cell-supplier font-semibold md:font-normal md:pe-6 md:py-3">
                <div class="flex items-center gap-3">
                  <img
                    src={`/suppliers/${row.logoFileName}`}
                    alt={row.supplierLabel}
                    loading="lazy"
                    width={48}
                    height={48}
                    class="h-12 w-12 md:h-10 md:w-10 object-contain shrink-0"
                  />
                  {row.supplierLabel}
                </div>
              </div>
              <div role="cell" class="cell-plan text-sm text-gray-600 md:text-foreground md:pe-6 md:py-3">
                {row.planLabel}
              </div>
              <div role="cell" class="cell-discount">
                <span class="tnum inline-block shrink-0 rounded-full bg-green-100 text-green-800 font-semibold px-2.5 py-1 text-sm md:rounded-none md:bg-transparent md:text-foreground md:font-normal md:px-0 md:py-3 md:pe-6">
                  {row.discountPercent}%
                </span>
              </div>
              <div role="cell" class="cell-type flex justify-between items-baseline md:block md:pe-6 md:py-3">
                <span class="cell-label text-gray-600 md:hidden inline-block min-w-[40%]">{common.table_type}</span>
                <span class="text-end md:text-start">{row.typeLabel}</span>
              </div>
              <div role="cell" class="cell-window flex justify-between items-baseline md:block md:pe-6 md:py-3">
                <span class="cell-label text-gray-600 md:hidden inline-block min-w-[40%]">{common.table_window}</span>
                <span class="text-end md:text-start">{row.window}</span>
              </div>
              <div role="cell" class="cell-weekday flex justify-between items-baseline md:block md:py-3">
                <span class="cell-label text-gray-600 md:hidden inline-block min-w-[40%]">{common.table_weekday_only}</span>
                <span class="text-end md:text-start">{row.weekdayOnly}</span>
              </div>
              <div role="cell" class="cell-actions md:py-3">
                <div class="flex flex-col gap-2 items-center md:min-h-[72px] md:justify-center">
                  <LeaveDetailsIsland
                    client:only="react"
                    locale={locale}
                    convexUrl={convexUrl}
                    supplierId={row.supplierId}
                    planVersionId={row.pvId}
                  />
                  {row.supportedHandoffTypes.includes("clickThrough") && (
                    <ClickThroughIsland
                      client:only="react"
                      locale={locale}
                      convexUrl={convexUrl}
                      supplierId={row.supplierId}
                      planVersionId={row.pvId}
                      supplierName={row.supplierName}
                    />
                  )}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .plan-header-row {
    display: none;
  }

  .plan-row.hidden {
    display: none;
  }

  .plan-row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "supplier discount"
      "plan discount"
      "type type"
      "window window"
      "weekday weekday"
      "actions actions";
    row-gap: 0.5rem;
    column-gap: 0.75rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .plan-header-row {
      display: grid;
    }

    .plan-header-row,
    .plan-row {
      grid-template-columns:
        minmax(0, 1fr) minmax(0, 1fr) 90px 110px 140px 110px 158px;
      grid-template-areas: "supplier plan type discount window weekday actions";
      column-gap: 0;
      row-gap: 0;
      align-items: center;
    }
  }

  .cell-supplier {
    grid-area: supplier;
  }
  .cell-plan {
    grid-area: plan;
  }
  .cell-type {
    grid-area: type;
  }
  .cell-discount {
    grid-area: discount;
  }
  .cell-window {
    grid-area: window;
  }
  .cell-weekday {
    grid-area: weekday;
  }
  .cell-actions {
    grid-area: actions;
  }
</style>
