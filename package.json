{
  "name": "ec2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "agent:dev": "npm run dev 2>&1 | tee /tmp/chisko-dev-server.log",
    "agent:dev:mobile": "npm run dev:mobile 2>&1 | tee /tmp/chisko-dev-server.log",
    "dev": "convex dev --start 'astro dev'",
    "dev:client-only": "astro dev",
    "dev:mobile": "npx tsx scripts/devMobile.ts",
    "setup:worktree": "npx tsx scripts/setupWorktree.ts",
    "teardown:worktree": "npx tsx scripts/teardownWorktree.ts",
    "build": "astro build",
    "lint": "tsc && eslint .  --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:branch": "npx tsx scripts/lintBranch.ts",
    "typecheck": "tsc",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.0",
    "@astrojs/vercel": "^11.0.0",
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@sentry/astro": "^10.62.0",
    "@types/nodemailer": "^8.0.1",
    "astro": "^7.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.36.1",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "lucide-react": "^1.17.0",
    "nodemailer": "^9.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.8",
    "react-router": "^7.17.0",
    "resend": "^6.14.0",
    "shadcn": "^4.11.0",
    "sharp": "^0.35.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "convex-test": "^0.0.53",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
